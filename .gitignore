# ---------------------------------------------------------------------------------------------------------------
# Kept on the development machine only, never deployed. The live site runs from its imported database and does not
# need any of these. (Backups and logs in storage/ and .env are already excluded above / by storage's own .gitignore.)
# ---------------------------------------------------------------------------------------------------------------

# Tests
/tests
/phpunit.xml
/database/factories
/database/seeders

# Migrations: the live database is imported as SQL in phpMyAdmin. Never run "php artisan migrate" on the server.
/database/migrations

