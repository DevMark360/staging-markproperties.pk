# Used only when the domain's document root is the project folder instead of public/ (cPanel's default for a new
# subdomain). Every request is passed into public/, so .env, app/, vendor/ and the rest can never be opened in a
# browser. If the document root already points to public/, this file is ignored.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
